# Copy this file to ".env" (exactly that name, no .txt) in the project root.
# Never commit the real .env file.

OPENAI_API_KEY=sk-your-openai-key

# Optional. Leave these two lines commented out to run with in-memory storage
# (data is lost on restart). To use Supabase, remove the "#" and fill in real values.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-secret-key

# Admin dashboard password. If you leave this out, a random temporary password
# is generated and printed in the server console on startup.
ADMIN_PASSWORD=choose-a-password

# Optional. Comma-separated list of frontend origins allowed to call the API.
# Defaults to * if unset. Set this in production, e.g.:
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional tuning (defaults shown)
# RESTAURANT_TIMEZONE=Europe/Belgrade
# CHAT_MODEL=gpt-4o-mini
# STT_MODEL=whisper-1        # OpenAI retires whisper-1 on 2027-02-26: switch to gpt-transcribe before then
# TTS_MODEL=tts-1
# AI_RATE_LIMIT_PER_MINUTE=30
# AI_GLOBAL_LIMIT_PER_HOUR=600
# LOGIN_RATE_LIMIT_PER_MINUTE=10
